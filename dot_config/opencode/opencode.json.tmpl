{{- $mcps := list -}}
{{- if and (hasKey . "ai") (hasKey .ai "mcps") -}}
  {{- $mcps = .ai.mcps -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {},
{{- if and (hasKey . "ai") (hasKey .ai "providers") (hasKey .ai.providers "aws") (ne .ai.providers.aws.profile "") }}
  "provider": {
    "amazon-bedrock": {
      "options": {
{{- if ne .ai.providers.aws.region "" }}
        "region": {{ .ai.providers.aws.region | quote }},
{{- end }}
        "profile": {{ .ai.providers.aws.profile | quote }}
      }
    }
  },
{{- end }}
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "enabled": true
    },
    "learn-microsoft": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": false
    },
{{- $sep := "" -}}
{{- range $mcps }}{{ $sep }}
    {{ .name | quote }}: {
      "enabled": {{ if hasKey . "enabled" }}{{ .enabled }}{{ else }}true{{ end }},
      "type": {{ .type | quote }}{{- if .url }},
      "url": {{ .url | quote }}{{- end }}
    }
{{- $sep = "," -}}
{{- end }}
  }
}
