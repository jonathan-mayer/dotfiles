{{- $mcps := .ai.mcps | default list -}}
{{- /* References and read permissions */ -}}
{{- $refs := dict -}}
{{- $read := dict -}}
{{- $edit := dict "**/.env.dist" "allow" "**/.env.example" "allow" -}}
{{- range (.ai.references | default list) -}}
  {{- $_ := set $refs .name (dict "path" .path "description" (.description | default "")) -}}
  {{- $_ := set $read (printf "%s/**" .path) "allow" -}}
{{- end -}}
{{- range (list (.dev.dev_path | default "") (.dev.main_path | default "")) -}}
  {{- if ne . "" -}}
    {{- $_ := set $read (printf "%s/**" .) "allow" -}}
  {{- end -}}
{{- end -}}
{{- range $glob, $action := $edit -}}
  {{- $_ := set $read $glob $action -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": { "/tmp/**": "allow" },
    "edit": {{ $edit | toPrettyJson | indent 4 | trim }},
    "read": {{ $read | toPrettyJson | indent 4 | trim }}
  },
  "references": {{ $refs | toPrettyJson | indent 2 | trim }},
{{- if and (hasKey . "ai") (hasKey .ai "providers") (hasKey .ai.providers "aws") (ne .ai.providers.aws.profile "") }}
  "provider": {
    "amazon-bedrock": {
      "options": {
{{- if ne .ai.providers.aws.region "" }}
        "region": {{ .ai.providers.aws.region | quote }},
{{- end }}
        "profile": {{ .ai.providers.aws.profile | quote }}
      }
    }
  },
{{- end }}
  "mcp": {
{{- /* Additional Setup:
      $ npx playwright install chrome firefox
*/}}
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "enabled": true
    },
    "learn-microsoft": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": false
    },
{{- $sep := "" -}}
{{- range $mcps }}{{ $sep }}
    {{ .name | quote }}: {
      "enabled": {{ if hasKey . "enabled" }}{{ .enabled }}{{ else }}true{{ end }},
      "type": {{ .type | quote }}{{- if .url }},
      "url": {{ .url | quote }}{{- end }}
    }
{{- $sep = "," -}}
{{- end }}
  }
}
