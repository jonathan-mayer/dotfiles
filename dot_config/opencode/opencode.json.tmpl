{{- $mcps := list -}}
{{- if and (hasKey . "ai") (hasKey .ai "mcps") -}}
  {{- $mcps = .ai.mcps -}}
{{- end -}}
{{- /* Global references: resolve "~" to the home dir */ -}}
{{- $references := list -}}
{{- if and (hasKey . "ai") (hasKey .ai "references") -}}
  {{- range .ai.references -}}
    {{- if and (ne .name "") (ne .path "") -}}
      {{- $path := .path -}}
      {{- if hasPrefix "~" $path -}}
        {{- $path = printf "%s%s" $.chezmoi.homeDir (trimPrefix "~" $path) -}}
      {{- end -}}
      {{- $description := "" -}}
      {{- if hasKey . "description" -}}
        {{- $description = .description -}}
      {{- end -}}
      {{- $references = append $references (dict "name" .name "path" $path "description" $description) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
{{- if $references }}
  "references": {
{{- $sep := "" -}}
{{- range $references }}{{ $sep }}
    {{ .name | quote }}: { "path": {{ .path | quote }}{{ if ne .description "" }}, "description": {{ .description | quote }}{{ end }} }
{{- $sep = "," -}}
{{- end }}
  },
{{- end }}
{{- if and (hasKey . "ai") (hasKey .ai "providers") (hasKey .ai.providers "aws") (ne .ai.providers.aws.profile "") }}
  "provider": {
    "amazon-bedrock": {
      "options": {
{{- if ne .ai.providers.aws.region "" }}
        "region": {{ .ai.providers.aws.region | quote }},
{{- end }}
        "profile": {{ .ai.providers.aws.profile | quote }}
      }
    }
  },
{{- end }}
  "mcp": {
{{- /* Additional Setup:
      $ npx playwright install chrome firefox
*/}}
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "enabled": true
    },
    "learn-microsoft": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": false
    },
{{- $sep := "" -}}
{{- range $mcps }}{{ $sep }}
    {{ .name | quote }}: {
      "enabled": {{ if hasKey . "enabled" }}{{ .enabled }}{{ else }}true{{ end }},
      "type": {{ .type | quote }}{{- if .url }},
      "url": {{ .url | quote }}{{- end }}
    }
{{- $sep = "," -}}
{{- end }}
  }
}
