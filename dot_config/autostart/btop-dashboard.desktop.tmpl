[Desktop Entry]
Type=Application
Name=btop dashboard (mini monitor)
Comment=Launches btop in Konsole on the dedicated mini monitor. Placed borderless and fullscreen by the KWin rule "btop-dashboard".
Exec=konsole --separate --profile BtopDashboard --hide-menubar --hide-tabbar --hide-toolbars --fullscreen -e btop --config {{ .chezmoi.homeDir }}/.config/btop/small-display.conf
Icon=utilities-system-monitor
Terminal=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
