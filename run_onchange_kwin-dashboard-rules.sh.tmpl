#! /bin/bash
set -eu

# Installs (or removes) the KWin (Plasma/Wayland) window rules that pin the
# dashboard windows onto a dedicated monitor:
#
#   dashboard-btop   Konsole running btop      (`dashboard btop`)
#   dashboard-media  mpv playing a series      (`dashboard watch <series>`)
#
# Controlled by the `dashboard` config parameters in
# ~/.config/chezmoi/chezmoi.toml (prompted by `chezmoi init`).
#
# Idempotent: each rule lives in its own fixed group in ~/.config/kwinrulesrc,
# all other rules are left untouched. Setting dashboard.enabled = false
# and re-applying removes them again.

RULES="${HOME}/.config/kwinrulesrc"
GROUPS=(dashboard-btop dashboard-media)

command -v kwriteconfig6 >/dev/null || { echo "kwriteconfig6 not found, skipping"; exit 0; }

RULE_KEYS=(Description wmclass wmclasscomplete wmclassmatch title titlematch types
           position positionrule size sizerule ignoregeometry ignoregeometryrule
           placement placementrule noborder noborderrule skiptaskbar skiptaskbarrule
           skippager skippagerrule skipswitcher skipswitcherrule below belowrule)

reconfigure_kwin() {
  qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 ||
    dbus-send --session --dest=org.kde.KWin --type=method_call /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 ||
    true
}

# keep [General]rules (the ordered list of rule groups) and count in sync
register_rule() {  # $1 = add|remove, $2 = group
  local action="$1" group="$2" rules new="" p
  rules="$(kreadconfig6 --file "$RULES" --group General --key rules 2>/dev/null || true)"
  IFS=',' read -r -a parts <<<"$rules"
  for p in "${parts[@]:-}"; do
    [ -z "$p" ] && continue
    [ "$p" = "$group" ] && continue
    new="${new:+${new},}${p}"
  done
  [ "$action" = "add" ] && new="${new:+${new},}${group}"
  kwriteconfig6 --file "$RULES" --group General --key rules "$new"
  kwriteconfig6 --file "$RULES" --group General --key count \
    "$(awk -F, '{ n = 0; for (i = 1; i <= NF; i++) if ($i != "") n++; print n }' <<<"$new")"
}

remove_rule() {  # $1 = group
  local group="$1" k
  kreadconfig6 --file "$RULES" --group General --key rules 2>/dev/null | grep -q "$group" || return 0
  for k in "${RULE_KEYS[@]}"; do
    kwriteconfig6 --file "$RULES" --group "$group" --key "$k" --delete '' 2>/dev/null || true
  done
  register_rule remove "$group"
  echo "KWin rule '$group' removed from $RULES"
}

{{- if not (and (hasKey . "dashboard") .dashboard.enabled) }}

# --- dashboard.enabled = false: make sure the rules are gone
for g in "${GROUPS[@]}"; do remove_rule "$g"; done
reconfigure_kwin
exit 0
{{- else }}

install_rule() {  # $1 = group, $2 = description, $3 = wmclass, $4 = title
  local group="$1"
  set_key() { kwriteconfig6 --file "$RULES" --group "$group" --key "$1" "$2"; }

  set_key Description        "$2"
  # --- matching: window class (case sensitive!) plus the fixed window title
  set_key wmclass            "$3"
  set_key wmclasscomplete    false
  set_key wmclassmatch       1          # 1 = exact match
  set_key title              "$4"
  set_key titlematch         2          # 2 = substring match
  set_key types              1          # normal windows only

  # --- geometry: force onto the dashboard monitor at its native resolution
  set_key position           {{ .dashboard.position | quote }}
  set_key positionrule       2          # 2 = force
  set_key size               {{ .dashboard.size | quote }}
  set_key sizerule           2
  set_key ignoregeometry     true
  set_key ignoregeometryrule 2
  set_key placement          0          # no automatic placement
  set_key placementrule      2

  # --- appearance / behaviour of a dedicated dashboard
  set_key noborder           true
  set_key noborderrule       2
  set_key skiptaskbar        true
  set_key skiptaskbarrule    2
  set_key skippager          true
  set_key skippagerrule      2
  set_key skipswitcher       true
  set_key skipswitcherrule   2
  set_key below              true
  set_key belowrule          2

  register_rule add "$group"
  echo "KWin rule '$group' installed in $RULES"
}

install_rule dashboard-btop  "btop dashboard on dedicated monitor"  "org.kde.konsole" "dashboard-btop"
install_rule dashboard-media "media dashboard on dedicated monitor" "mpv"             "dashboard-media"

reconfigure_kwin
{{- end }}
